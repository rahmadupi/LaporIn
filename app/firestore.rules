rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ================= USERS =================
    match /users/{uidDoc} {

      allow read: if isSignedIn() && uid() == uidDoc;

      allow create: if isSignedIn()
        && uid() == uidDoc
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "citizen";

      allow update: if isSignedIn()
        && uid() == uidDoc
        && resource.data.role == request.resource.data.role;

      allow delete: if false;
    }

    // ================= REPORTS =================
    match /reports/{reportId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.reporterId == uid()
        && request.resource.data.status == "pending"
        && request.resource.data.isDeleted == false
        && request.resource.data.description is string
        && request.resource.data.address is string;

      // Hanya pemilik (reporterId == uid) yang boleh update. Warga hanya boleh
      // mengubah deskripsi (FR-2.4) dan men-soft-delete (FR-2.5) miliknya. Field
      // yang menentukan alur kerja/identitas DIKUNCI agar tidak bisa dimanipulasi
      // dari klien: hanya proses moderasi sisi-server (Admin/Officer) yang berhak
      // mengubah `status`. Tanpa server, status efektif immutable dari aplikasi.
      allow update: if isSignedIn()
        && resource.data.reporterId == uid()
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.status == resource.data.status
        && request.resource.data.isAnonymous == resource.data.isAnonymous
        && request.resource.data.category == resource.data.category
        && request.resource.data.severity == resource.data.severity
        && request.resource.data.reportId == resource.data.reportId;

      allow delete: if false;
    }

    // ================= RATINGS =================
    match /ratings/{ratingId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.reporterId == uid()
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;

      allow update, delete: if false;
    }

    // ================= NOTIFICATIONS =================
    match /notifications/{notifId} {

      allow read: if isSignedIn()
        && resource.data.userId == uid();

      allow create: if isSignedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.title is string
        && request.resource.data.message is string;

      allow update: if isSignedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == resource.data.userId;

      allow delete: if false;
    }

    // ================= WATCH ZONES =================
    match /watch_zones/{zoneId} {

      allow read: if isSignedIn()
        && resource.data.userId == uid();

      allow create: if isSignedIn()
        && request.resource.data.userId == uid()
        && request.resource.data.name is string
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.radius is number;

      allow update: if isSignedIn()
        && resource.data.userId == uid()
        && request.resource.data.userId == resource.data.userId;

      allow delete: if false;
    }
  }
}